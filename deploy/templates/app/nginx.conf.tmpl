# Lanpanel-managed: app.name={{ .AppName }}
# Source: deploy/templates/app/nginx.conf.tmpl

{{- if .GoAccess.Enabled }}
{{- if .GoAccess.EnhancedLogFormat }}
log_format {{ .GoAccess.NginxLogFormatName }} '$remote_addr - $remote_user [$time_iso8601] "$request" $status $body_bytes_sent "$http_referer" "$http_user_agent" "$host" $request_time "$upstream_status" "$upstream_response_time"';

{{- end }}
{{- end }}
{{- if .RealIP.Enabled }}
log_format {{ .RealIP.RejectionLogFormatName }} '$time_iso8601 app={{ .AppName }} profile={{ .RealIP.ProfileName }} provider={{ .RealIP.Provider }} reason="${{ .RealIP.RejectReasonVariable }}" source="${{ .RealIP.OriginalSourceVariable }}" remote="$remote_addr" host="$host" status=$status';

{{- end }}
map $http_upgrade ${{ .VarPrefix }}_connection_upgrade {
    default upgrade;
    '' close;
}

map $http_host ${{ .VarPrefix }}_host_header_valid {
    default 0;
{{- range .Domains }}
    "{{ . }}" 1;
    "{{ . }}:80" 1;
    "{{ . }}:443" 1;
{{- end }}
}

map $http_host ${{ .VarPrefix }}_validated_host {
    default "";
{{- range .Domains }}
    "{{ . }}" "{{ . }}";
    "{{ . }}:80" "{{ . }}";
    "{{ . }}:443" "{{ . }}";
{{- end }}
}

map $ssl_server_name ${{ .VarPrefix }}_sni_valid {
    default 0;
{{- range .Domains }}
    "{{ . }}" 1;
{{- end }}
}

{{- if .RealIP.Enabled }}
map $realip_remote_addr ${{ .RealIP.OriginalSourceVariable }} {
    default $realip_remote_addr;
    "" $remote_addr;
}

geo ${{ .RealIP.OriginalSourceVariable }} ${{ .RealIP.SourceTrustedVariable }} {
    default 0;
    include {{ .RealIP.TrustedCIDRPath }};
}

map $http_eo_connecting_ip ${{ .RealIP.HeaderIsIPVariable }} {
    default 0;
    "~^(?:(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})\.){3}(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})$" 1;
    "~*^(?:[0-9a-f]{1,4}:){7}[0-9a-f]{1,4}$" 1;
    "~*^(?:[0-9a-f]{1,4}:){1,7}:$" 1;
    "~*^(?:[0-9a-f]{1,4}:){1,6}:[0-9a-f]{1,4}$" 1;
    "~*^(?:[0-9a-f]{1,4}:){1,5}(?::[0-9a-f]{1,4}){1,2}$" 1;
    "~*^(?:[0-9a-f]{1,4}:){1,4}(?::[0-9a-f]{1,4}){1,3}$" 1;
    "~*^(?:[0-9a-f]{1,4}:){1,3}(?::[0-9a-f]{1,4}){1,4}$" 1;
    "~*^(?:[0-9a-f]{1,4}:){1,2}(?::[0-9a-f]{1,4}){1,5}$" 1;
    "~*^[0-9a-f]{1,4}:(?:(?::[0-9a-f]{1,4}){1,6})$" 1;
    "~*^::(?:[0-9a-f]{1,4}:){0,6}[0-9a-f]{1,4}$" 1;
    "::" 1;
}

geo $http_eo_connecting_ip ${{ .RealIP.HeaderPublicVariable }} {
    default 0;
    0.0.0.0/1 1;
    128.0.0.0/1 1;
    0.0.0.0/8 0;
    10.0.0.0/8 0;
    100.64.0.0/10 0;
    127.0.0.0/8 0;
    169.254.0.0/16 0;
    172.16.0.0/12 0;
    192.0.0.0/24 0;
    192.0.2.0/24 0;
    192.31.196.0/24 0;
    192.52.193.0/24 0;
    192.88.99.0/24 0;
    192.168.0.0/16 0;
    192.175.48.0/24 0;
    198.18.0.0/15 0;
    198.51.100.0/24 0;
    203.0.113.0/24 0;
    224.0.0.0/4 0;
    240.0.0.0/4 0;
    2000::/3 1;
    ::/128 0;
    ::1/128 0;
    ::ffff:0:0/96 0;
    64:ff9b::/96 0;
    64:ff9b:1::/48 0;
    100::/64 0;
    100:0:0:1::/64 0;
    2001::/23 0;
    2001:2::/48 0;
    2001:db8::/32 0;
    2002::/16 0;
    2620:4f:8000::/48 0;
    3fff::/20 0;
    5f00::/16 0;
    fc00::/7 0;
    fe80::/10 0;
    ff00::/8 0;
}

map "${{ .RealIP.SourceTrustedVariable }}:${{ .RealIP.HeaderIsIPVariable }}:${{ .RealIP.HeaderPublicVariable }}:$http_eo_connecting_ip" ${{ .RealIP.RejectReasonVariable }} {
    default "";
    ~^0:[01]:[01]: "untrusted_source_ip";
    ~^1:[01]:[01]:.*,.* "duplicate_eo_connecting_ip";
    ~^1:0:[01]: "missing_or_invalid_eo_connecting_ip";
    ~*^1:1:[01]:::ffff: "missing_or_invalid_eo_connecting_ip";
    ~^1:1:0: "missing_or_invalid_eo_connecting_ip";
}

map ${{ .RealIP.RejectReasonVariable }} ${{ .RealIP.RejectLogVariable }} {
    default 1;
    "" 0;
}

{{- end }}
upstream {{ .VarPrefix }}_upstream {
    server {{ .UpstreamAddress }};
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name {{ .ServerNames }};
{{- if .RealIP.Enabled }}
    include {{ .RealIP.NginxIncludePath }};
    real_ip_header {{ .RealIP.Header }};
    error_page 418 = @{{ .VarPrefix }}_realip_reject;
{{- end }}
{{- if .AccessLog }}
{{- if .GoAccess.Enabled }}
{{- if .GoAccess.EnhancedLogFormat }}
    access_log {{ .AccessLog }} {{ .GoAccess.NginxLogFormatName }};
{{- else }}
    access_log {{ .AccessLog }} combined;
{{- end }}
{{- else }}
    access_log {{ .AccessLog }};
{{- end }}
{{- end }}
{{- if .ErrorLog }}
    error_log {{ .ErrorLog }};
{{- end }}

    if (${{ .VarPrefix }}_host_header_valid = 0) {
        return 421;
    }

{{- if .RealIP.Enabled }}
    if (${{ .RealIP.RejectReasonVariable }} != "") {
        return 418;
    }

    location @{{ .VarPrefix }}_realip_reject {
        internal;
        access_log {{ .RealIP.RejectionLogPath }} {{ .RealIP.RejectionLogFormatName }} if=${{ .RealIP.RejectLogVariable }};
        return 400 "lanpanel realip rejected: ${{ .RealIP.RejectReasonVariable }}\n";
    }

{{- end }}
    location /.well-known/acme-challenge/ {
        root {{ .WebrootPath }};
    }

{{- if .GoAccess.Enabled }}
    location = {{ .GoAccess.DashboardPath }} {
        access_log off;
        return 301 {{ .GoAccess.DashboardURL }};
    }

    location = {{ .GoAccess.WebSocketPath }} {
        access_log off;
        return 421;
    }

{{- end }}
    location / {
        return 301 https://${{ .VarPrefix }}_validated_host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{ .ServerNames }};
{{- if .RealIP.Enabled }}
    include {{ .RealIP.NginxIncludePath }};
    real_ip_header {{ .RealIP.Header }};
    error_page 418 = @{{ .VarPrefix }}_realip_reject;
{{- end }}
{{- if .AccessLog }}
{{- if .GoAccess.Enabled }}
{{- if .GoAccess.EnhancedLogFormat }}
    access_log {{ .AccessLog }} {{ .GoAccess.NginxLogFormatName }};
{{- else }}
    access_log {{ .AccessLog }} combined;
{{- end }}
{{- else }}
    access_log {{ .AccessLog }};
{{- end }}
{{- end }}
{{- if .ErrorLog }}
    error_log {{ .ErrorLog }};
{{- end }}
{{- if .HTTP2 }}
    http2 on;
{{- end }}

    ssl_certificate {{ .FullchainPath }};
    ssl_certificate_key {{ .PrivateKeyPath }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:{{ .VarPrefix }}_tls:10m;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=15552000" always;

    client_max_body_size {{ .ClientMaxBodySize }};

    if (${{ .VarPrefix }}_sni_valid = 0) {
        return 421;
    }

    if (${{ .VarPrefix }}_host_header_valid = 0) {
        return 421;
    }

{{- if .RealIP.Enabled }}
    if (${{ .RealIP.RejectReasonVariable }} != "") {
        return 418;
    }

    location @{{ .VarPrefix }}_realip_reject {
        internal;
        access_log {{ .RealIP.RejectionLogPath }} {{ .RealIP.RejectionLogFormatName }} if=${{ .RealIP.RejectLogVariable }};
        return 400 "lanpanel realip rejected: ${{ .RealIP.RejectReasonVariable }}\n";
    }

{{- end }}
{{- if .GoAccess.Enabled }}
    location = {{ .GoAccess.DashboardPath }} {
        if ($host != "{{ .PrimaryDomain }}") {
            return 301 {{ .GoAccess.DashboardURL }};
        }
        alias {{ .GoAccess.ReportPath }};
        default_type text/html;
        disable_symlinks on;
        satisfy all;
        auth_basic "Lanpanel GoAccess";
        auth_basic_user_file {{ .GoAccess.AuthBasicUserFile }};
{{- range .GoAccess.AuthCIDRAllowlist }}
        allow {{ . }};
{{- end }}
{{- if .GoAccess.AuthCIDRAllowlist }}
        deny all;
{{- end }}
        access_log off;
    }

    location = {{ .GoAccess.WebSocketPath }} {
        if ($host != "{{ .PrimaryDomain }}") {
            return 421;
        }
        proxy_pass http://{{ .GoAccess.WebSocketUpstream }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection ${{ .VarPrefix }}_connection_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
{{- if .RealIP.Enabled }}
        proxy_set_header X-Forwarded-For $remote_addr;
{{- else }}
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
{{- end }}
        proxy_set_header X-Forwarded-Host ${{ .VarPrefix }}_validated_host;
        proxy_set_header X-Forwarded-Proto $scheme;
{{- if .RealIP.Enabled }}
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header X-Original-Forwarded-For "";
        proxy_set_header X-Client-IP "";
        proxy_set_header Client-IP "";
        proxy_set_header True-Client-IP "";
        proxy_set_header EO-Connecting-IP "";
        proxy_set_header EO-Client-IP "";
{{- end }}
        proxy_read_timeout 3600s;
        proxy_send_timeout 60s;
        satisfy all;
        auth_basic "Lanpanel GoAccess";
        auth_basic_user_file {{ .GoAccess.AuthBasicUserFile }};
{{- range .GoAccess.AuthCIDRAllowlist }}
        allow {{ . }};
{{- end }}
{{- if .GoAccess.AuthCIDRAllowlist }}
        deny all;
{{- end }}
        access_log off;
    }

{{ end }}
{{ range .StaticLocations }}
    location {{ if .Exact }}= {{ end }}{{ .Path }} {
        alias {{ .Alias }};
{{- if $.Access.Browser }}
        satisfy all;
        auth_basic "Lanpanel Browser";
        auth_basic_user_file {{ $.Access.AuthBasicUserFile }};
{{- range $.Access.CIDRAllowlist }}
        allow {{ . }};
{{- end }}
{{- if $.Access.CIDRAllowlist }}
        deny all;
{{- end }}
{{- end }}
{{- if .DefaultType }}
        default_type {{ .DefaultType }};
{{- end }}
{{- if .Expires }}
        expires {{ .Expires }};
{{- end }}
{{- if .CacheControl }}
        add_header Cache-Control "{{ .CacheControl }}";
{{- end }}
{{- if .TryFiles }}
        try_files $uri =404;
{{- end }}
{{- if .GzipStatic }}
        gzip_static on;
{{- end }}
{{- if .AccessLogOff }}
        access_log off;
{{- end }}
    }

{{ end }}
    location / {
        proxy_pass http://{{ .VarPrefix }}_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host ${{ .VarPrefix }}_validated_host;
{{- if .Access.Browser }}
        proxy_set_header Authorization "";
{{- end }}
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection ${{ .VarPrefix }}_connection_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
{{- if .RealIP.Enabled }}
        proxy_set_header X-Forwarded-For $remote_addr;
{{- else }}
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
{{- end }}
        proxy_set_header X-Forwarded-Host ${{ .VarPrefix }}_validated_host;
        proxy_set_header X-Forwarded-Proto $scheme;
{{- if .RealIP.Enabled }}
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header X-Original-Forwarded-For "";
        proxy_set_header X-Client-IP "";
        proxy_set_header Client-IP "";
        proxy_set_header True-Client-IP "";
        proxy_set_header EO-Connecting-IP "";
        proxy_set_header EO-Client-IP "";
{{- end }}
{{- if .Proxy.ConnectTimeout }}
        proxy_connect_timeout {{ .Proxy.ConnectTimeout }};
{{- end }}
        proxy_read_timeout {{ .Proxy.ReadTimeout }};
        proxy_send_timeout {{ .Proxy.SendTimeout }};
{{- if .Proxy.BufferingSet }}
        proxy_buffering {{ .Proxy.Buffering }};
{{- end }}
{{- if .Proxy.RequestBufferingSet }}
        proxy_request_buffering {{ .Proxy.RequestBuffering }};
{{- end }}
{{- if .Access.Browser }}
        satisfy all;
        auth_basic "Lanpanel Browser";
        auth_basic_user_file {{ .Access.AuthBasicUserFile }};
{{- range .Access.CIDRAllowlist }}
        allow {{ . }};
{{- end }}
{{- if .Access.CIDRAllowlist }}
        deny all;
{{- end }}
{{- end }}
        proxy_redirect off;
    }
}
