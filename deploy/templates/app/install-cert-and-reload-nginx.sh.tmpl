#!/bin/sh
# Lanpanel-managed: app.name={{ .AppName }}
# Source: deploy/templates/app/install-cert-and-reload-nginx.sh.tmpl
set -eu

: "${LEGO_HOOK_CERT_PATH:?}"
: "${LEGO_HOOK_CERT_KEY_PATH:?}"

target_dir="{{ .TLSDir }}"
marker="{{ .TLSMarkerPath }}"
expected_marker="Lanpanel-managed: app.name={{ .AppName }}"

if [ ! -f "$marker" ]; then
    echo "certificate target is not owned by Lanpanel for app {{ .AppName }}: $marker missing" >&2
    exit 1
fi
actual_marker="$(cat "$marker")"
if [ "$actual_marker" != "$expected_marker" ]; then
    echo "certificate target is managed by a different Lanpanel app: $marker" >&2
    exit 1
fi

install -m 0644 "$LEGO_HOOK_CERT_PATH" "$target_dir/fullchain.pem"
install -m 0600 "$LEGO_HOOK_CERT_KEY_PATH" "$target_dir/privkey.pem"

nginx -t
systemctl reload nginx.service
