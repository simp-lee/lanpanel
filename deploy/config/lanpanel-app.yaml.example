api_version: lanpanel/app/v1alpha2

app:
  name: "example-app"
  domains:
    - "abc.com"
    - "www.abc.com"
  certificate_email: "ops@example.com"
  acme_challenge: "http-01" # http-01 | dns-01

  # Set exactly one mode:
  # - listen: local Go service on this host, proxied by Nginx.
  # - upstream: fixed tailnet HTTP/WebSocket upstream, for example 100.64.10.20:18001.
  listen: "127.0.0.1:18001"
  upstream: ""

access:
  # Required. Use browser for LanPanel Basic Auth at the app gateway, or public
  # for an intentionally public HTTPS app with explicit risk confirmation.
  access_mode: "browser" # browser | public
  # CIDR allowlist is an extra source-IP gate. It never bypasses Basic Auth.
  cidr_allowlist: []
  # Required only when access_mode is public.
  public_risk_confirmed: false
  browser_auth:
    # Browser app auth is separate from nginx.goaccess.auth_basic_user_file.
    # Use exactly one browser credential source:
    # - auth_basic_user_file: external app-gateway htpasswd, not GoAccess.
    # - managed: LanPanel-created credential under /etc/lanpanel/browser-auth.
    # Managed passwords are shown only as one-time UI secrets after create/rotate;
    # configs and job history store only credential metadata and password_fingerprint.
    # Managed delete is fail-closed: remove files manually after verifying no active
    # or staged browser app config still references the htpasswd path.
    # browser mode clears upstream Authorization. Apps that need business-layer
    # Authorization must use explicit public exposure or wait for upstream-auth support.
    auth_basic_user_file: "/etc/example-app/browser.htpasswd"
    managed:
      credential_id: ""
      htpasswd_path: ""
      username: ""
      password_fingerprint: ""
  origin_protection:
    # Required. none means direct origin exposure and requires explicit risk
    # confirmation. edgeone requires edgeone_profile below and DNS-01.
    mode: "none" # none | edgeone
    direct_origin_risk_confirmed: true
    edgeone_profile: ""

service:
  # listen mode only. The first token must be the absolute business binary path.
  exec_start: "/opt/example-app/example-app --listen 127.0.0.1:18001"
  # Optional systemd WorkingDirectory. This is not the binary path.
  working_directory: "/opt/example-app"
  # Optional root-owned, root-only systemd EnvironmentFile for app config.
  env_file: ""

nginx:
  client_max_body_size: "20m"
  # Set true only when the target Nginx is >= 1.25.1 and has http_v2.
  # Default is false so first app-only deploys do not require modern HTTP/2 support.
  # When true, Lanpanel renders the modern "http2 on;" directive.
  http2: false
  # Optional per-app Nginx logs. access_log may also be "off".
  # With GoAccess enabled and access_log empty, Lanpanel uses
  # /var/log/lanpanel/apps/<app-name>/access.log and manages logrotate.
  # The exact /var/log/lanpanel/apps/<app-name>/access.log path is still managed.
  # Other explicit files are the canonical source, but Lanpanel does not create them,
  # chown foreign roots, or install Lanpanel logrotate for them.
  # External explicit access logs must already be regular non-symlink files owned
  # by root or www-data, not writable by group or others.
  # Deploy creates or confirms the GoAccess runtime user before the final readability check.
  # A 0640 file readable by that Lanpanel-created group is valid.
  # GoAccess rejects explicit access_log paths under /home, /root, /run/user,
  # /tmp, /var/tmp, or /var/log/nginx. The first set is hidden by
  # ProtectHome/PrivateTmp; /var/log/nginx is commonly owned by distro logrotate.
  access_log: ""
  # With GoAccess enabled, error_log must not equal the GoAccess canonical
  # access log or auth_basic_user_file, point to generated app/GoAccess artifacts,
  # or live under /var/lib/<app-name>, /etc/<app-name>,
  # /usr/local/lib/lanpanel/apps/<app-name>, /var/lib/<app-name>/goaccess,
  # or /var/log/lanpanel/apps/<app-name>.
  error_log: ""

  # Optional GoAccess access-log dashboard. Keep disabled unless explicitly configured.
  # When enabled, auth_basic_user_file is required and must point to an existing
  # regular, non-empty htpasswd file with at least one user:hash credential line.
  # Credential line user and hash fields must not contain whitespace.
  # Keep the file root-owned, not group-writable, not accessible by other local users,
  # and readable by the Nginx runtime user, for example mode 0640 with group www-data.
  # Every parent directory must be root-owned, not writable by group or others,
  # and searchable by the Nginx runtime user.
  # Under /etc/<app-name>, use the direct /etc/<app-name>/goaccess.htpasswd
  # bootstrap path rather than a nested child path.
  # The Management UI does not manage GoAccess htpasswd files. Create the
  # htpasswd file on the server before enabling GoAccess, then store its
  # absolute path in nginx.goaccess.auth_basic_user_file.
  # Create it on Debian/Ubuntu with:
  #   # Install the htpasswd command; it is provided by apache2-utils.
  #   sudo apt install -y apache2-utils
  #   # Create the app-specific config directory.
  #   sudo install -d -o root -g root -m 0755 /etc/example-app
  #   # Create the htpasswd file and the goaccess user for the first time.
  #   sudo htpasswd -c -m /etc/example-app/goaccess.htpasswd goaccess
  #   # Keep it root-owned while allowing Nginx's www-data group to read it.
  #   sudo chown root:www-data /etc/example-app/goaccess.htpasswd
  #   # Allow root read/write and www-data group read; block other users.
  #   sudo chmod 0640 /etc/example-app/goaccess.htpasswd
  # Use -c only for the first user; omit -c when adding or updating users.
  # GoAccess uses persist true, restore true, and db-path
  # /var/lib/<app-name>/goaccess/db.
  # Enabled GoAccess is a real-time HTML dashboard: Nginx serves
  # /var/lib/<app-name>/goaccess/report.html and Lanpanel proxies live
  # WebSocket updates at websocket_path.
  # auth_cidr_allowlist is an extra source-IP gate; it does not bypass basic auth.
  # language en requires C.UTF-8; zh-CN requires both C.UTF-8 and zh_CN.UTF-8.
  # The language option changes only GoAccess UI text, not raw access log fields.
  # path and websocket_path usually stay unset; Lanpanel derives them from app.name.
  goaccess:
    enabled: false
    # language: "en" # en | zh-CN
    # log_format: "enhanced" # enhanced | combined
    # auth_basic_user_file: "/etc/example-app/goaccess.htpasswd"
    # auth_cidr_allowlist: [] # source IP must match and basic auth must pass
    # path: "/_lanpanel/apps/example-app/goaccess"
    # websocket_path: "/_lanpanel/apps/example-app/goaccess/ws"
    # Leave websocket_listen empty unless you need a fixed override. Explicit values
    # must be a loopback IP literal such as 127.0.0.1:<port> or [::1]:<port>,
    # must not reuse Lanpanel reserved ports, and must not overlap app.listen,
    # the main Headscale metrics listener, or an existing listener on the same
    # bind address unless held by this app's managed GoAccess service or managed
    # app service during deploy handoff.
    # websocket_listen: "" # defaults to 127.0.0.1:<app-derived-port>

  proxy:
    connect_timeout: ""
    read_timeout: "600s"
    send_timeout: "600s"
    # Uncomment for streaming/SSE or upload-forwarding workloads.
    # buffering: false
    # request_buffering: false

  # Optional HTTPS static aliases rendered before the app proxy location.
  # Lanpanel configures Nginx only; publish these files with your app release.
  static_locations: []
  # Example:
  #   - path: "/static/"
  #     alias: "/opt/example-app/web/static/"
  #     # Prefer either expires or cache_control. If both are set, both directives render.
  #     cache_control: "public, max-age=2592000"
  #     try_files: true
  #     gzip_static: true
  #     access_log: false
  #   - path: "/sitemap.xml"
  #     match: "exact" # prefix | exact
  #     alias: "/opt/example-app/web/static/sitemap.xml"
  #     default_type: "application/xml"

realip:
  # Shared host-level realip profiles. Default is off; do not put secrets here.
  profiles: {}
  # Example EdgeOne profile:
  # profiles:
  #   edgeone-prod:
  #     enabled: true
  #     provider: "edgeone"
  #     # Uses Tencent Cloud China EdgeOne API endpoint teo.tencentcloudapi.com.
  #     # International endpoint teo.intl.tencentcloudapi.com is not supported.
  #     # Defaults to 72h; minimum is 1h. Use
  #     # `sudo lanpanel app realip refresh --config /etc/lanpanel/lanpanel-app.yaml --profile edgeone-prod`
  #     # for immediate synchronization. Add --confirmation origin-protection-manual
  #     # only when the refresh output requires it.
  #     # Use `sudo lanpanel app realip diagnostics --config /etc/lanpanel/lanpanel-app.yaml --profile edgeone-prod`
  #     # to inspect deployed state, references, credentials, and includes.
  #     refresh_interval: "72h"
  #     edgeone:
  #       zone_id: "zone-xxxxxxxx"
  #       # The env_file must be root-owned and root-only. It must contain
  #       # TENCENTCLOUD_SECRET_ID_FILE and TENCENTCLOUD_SECRET_KEY_FILE.
  #       # TENCENTCLOUD_SESSION_TOKEN_FILE is optional for temporary credentials.
  #       # Direct TENCENTCLOUD_SECRET_ID / TENCENTCLOUD_SECRET_KEY /
  #       # TENCENTCLOUD_SESSION_TOKEN values are rejected.
  #       # It may reference the same SecretId/SecretKey files used by dns01.env_file
  #       # for Tencent Cloud HTTPS certificate issuance, for example:
  #       # TENCENTCLOUD_SECRET_ID_FILE=/etc/lanpanel/dns01/tencentcloud-secret-id
  #       # TENCENTCLOUD_SECRET_KEY_FILE=/etc/lanpanel/dns01/tencentcloud-secret-key
  #       # Keep the realip env_file separate when dns01.env_file also contains
  #       # lego DNS polling or propagation tuning.
  #       env_file: "/etc/lanpanel/realip/edgeone-prod.env"
  #
  # To use this profile for an app, set app.acme_challenge to dns-01,
  # configure dns01.provider/env_file, and set:
  # access:
  #   origin_protection:
  #     mode: "edgeone"
  #     direct_origin_risk_confirmed: false
  #     edgeone_profile: "edgeone-prod"

dns01:
  provider: ""
  # Supported lego providers: cloudflare, route53, digitalocean, gcloud,
  # tencentcloud. "google" is accepted as an alias for gcloud.
  # Cloudflare, DigitalOcean, and Tencent Cloud require a root-owned, root-only env_file.
  #
  # Tencent Cloud DNSPod / EdgeOne baseline env_file tuning:
  # Keep provider credential _FILE variables in the env_file, then add the
  # recursive polling baseline below. It keeps lego polling every 10 seconds
  # while skipping the authoritative NS propagation check that can fail with
  # EdgeOne / DNSPod hosted access.
  # TENCENTCLOUD_PROPAGATION_TIMEOUT=900
  # TENCENTCLOUD_POLLING_INTERVAL=10
  # TENCENTCLOUD_TTL=600
  # TENCENTCLOUD_HTTP_TIMEOUT=60
  # LEGO_DNS_RESOLVERS=119.29.29.29:53
  # LEGO_DNS_TIMEOUT=30
  # LEGO_DNS_PROPAGATION_DISABLE_ANS=true
  env_file: ""

tailscale:
  # upstream mode enables the Tailscale client precondition automatically.
  # Set true only when a listen-mode app must also initiate tailnet access.
  enabled_for_listen: false

  # Defaults:
  # - lanpanel_config: when login_server is empty, read ./lanpanel.yaml.
  #   For app-only upstream configs without a main lanpanel.yaml, set
  #   login_server explicitly and provide auth_key_file or pre-login the client.
  # - login_server: derived from lanpanel_config default.server_url
  # - hostname: omitted so Tailscale uses the system hostname
  # - auth_key_file: root-owned, root-only key file path for external Headscale only
  lanpanel_config: ""
  login_server: ""
  hostname: ""
  auth_key_file: ""

dependencies:
  lego_source:
    # direct downloads the pinned lego archive from GitHub. Offline mode must
    # point at the exact pinned archive for dependencies.platform.arch; Lanpanel
    # verifies the built-in SHA-256 digest.
    mode: "direct" # direct | offline
    file_path: ""

  package_probe:
    # Used by app-only lego archive reachability and SHA-256 verification.
    reachability_timeout: "30s"
    artifact_timeout: "5m"

  proxy:
    # Applied to app deploy package commands and artifact downloads.
    http_proxy: ""
    https_proxy: ""
    no_proxy: ""

  platform:
    # lanpanel app init writes the current binary architecture by default.
    arch: "amd64"
